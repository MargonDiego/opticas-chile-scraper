<header class="sticky top-0 z-40 w-full border-b border-border/80 bg-background/95 backdrop-blur-md">
  <div class="container max-w-7xl mx-auto flex h-16 items-center justify-between px-4 sm:px-8">
    <div class="flex items-center gap-3.5">
      <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-foreground text-background shadow-xs">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="15" r="4"></circle>
          <circle cx="18" cy="15" r="4"></circle>
          <line x1="14" y1="15" x2="10" y2="15"></line>
          <path d="M2.5 13 5 7c.7-1.3 1.4-2 3-2"></path>
          <path d="M21.5 13 19 7c-.7-1.3-1.4-2-3-2"></path>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-sm font-black tracking-tight text-foreground uppercase">
            Ópticas Chile
          </span>
          <span class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-muted text-muted-foreground border border-border/60 uppercase">
            Index v1.4
          </span>
        </div>
        <p class="font-mono text-[9px] font-bold text-muted-foreground tracking-wider uppercase">
          Monitor de Precios & Catálogo en Vivo
        </p>
      </div>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono">
      <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-muted/60 text-foreground border border-border/80 text-[11px] font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>7 Cadenas en Vivo</span>
      </div>
    </div>
  </div>
</header>