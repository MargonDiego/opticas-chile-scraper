---
const navLinks = [
  { label: "Catálogo", href: "#buscar" },
  { label: "Cómo funciona", href: "#como-funciona" },
  { label: "Fuentes", href: "#fuentes" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-card safe-top">
  <div class="container flex h-14 sm:h-16 items-center justify-between gap-3">
    <!-- Brand -->
    <a
      href="/"
      aria-label="Ópticas Chile, ir al inicio"
      class="flex min-h-11 items-center gap-2 rounded-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <span
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-foreground text-background"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="6" cy="15" r="4"></circle>
          <circle cx="18" cy="15" r="4"></circle>
          <line x1="14" y1="15" x2="10" y2="15"></line>
          <path d="M2.5 13 5 7c.7-1.3 1.4-2 3-2"></path>
          <path d="M21.5 13 19 7c-.7-1.3-1.4-2-3-2"></path>
        </svg>
      </span>
      <span class="text-[15px] font-semibold tracking-normal text-foreground"
        >Ópticas Chile</span
      >
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      <!-- Live status -->
      <div
        class="hidden sm:flex items-center gap-2 rounded-sm border border-border bg-card px-2.5 py-1"
      >
        <span
          class="h-1.5 w-1.5 rounded-full bg-success animate-pulse"
          aria-hidden="true"
        ></span>
        <span class="text-body-sm text-muted-foreground"
          ><span class="hidden sm:inline">7 ópticas · </span>en vivo</span
        >
      </div>

      <!-- Desktop navigation -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-1">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center rounded-sm px-3 text-label text-muted-foreground transition-colors duration-fast ease-out hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Mobile menu trigger -->
      <button
        type="button"
        id="boton-menu"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        class="lg:hidden flex h-11 w-11 items-center justify-center rounded-md text-foreground transition-colors duration-fast ease-out hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        <svg
          id="icono-menu"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg
          id="icono-cerrar"
          class="w-5 h-5 hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="menu-movil" class="lg:hidden hidden border-t border-border bg-card">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="flex min-h-11 items-center px-4 text-title text-foreground transition-colors duration-fast ease-out hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>("#boton-menu");
  const panel = document.querySelector<HTMLElement>("#menu-movil");
  const iconoMenu = document.querySelector<SVGElement>("#icono-menu");
  const iconoCerrar = document.querySelector<SVGElement>("#icono-cerrar");

  // Guard against the bundled script running twice (Astro HMR).
  if (boton && panel && iconoMenu && iconoCerrar && !boton.dataset.bound) {
    boton.dataset.bound = "true";

    const setOpen = (open: boolean): void => {
      boton?.setAttribute("aria-expanded", String(open));
      boton?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      panel?.classList.toggle("hidden", !open);
      iconoMenu?.classList.toggle("hidden", open);
      iconoCerrar?.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
    };

    boton.addEventListener("click", () => {
      setOpen(boton.getAttribute("aria-expanded") !== "true");
    });

    panel.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && boton.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        boton.focus();
      }
    });
  }
</script>
