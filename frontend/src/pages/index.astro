---
import Layout from "@/layouts/Layout.astro";
import { CatalogExplorer } from "@/components/CatalogExplorer";
import { AdvisorChatWidget } from "@/components/AdvisorChatWidget";

// Backend API configuration from env or production default
const apiBaseUrl = import.meta.env.PUBLIC_API_URL || "https://api-lentes.ste-tellega.com";
const apiKey = import.meta.env.PUBLIC_API_KEY || "";
---

<Layout title="Ópticas Chile - Comparador de Precios y Catálogo en Vivo">
    {/* Editorial Hero Section */}
    <div class="max-w-3xl mx-auto text-center space-y-3 pt-4 pb-2">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground leading-[1.15]">
        El índice independiente de lentes y ópticas en Chile
      </h2>
      <p class="text-sm sm:text-base text-muted-foreground leading-relaxed max-w-2xl mx-auto font-normal">
        Monitoreo automatizado en tiempo real de miles de armazones y lentes en GMO, Rotter & Krauss, Schilling, Place Vendôme, Econópticas, Karün y Lentesplus.
      </p>
    </div>

    {/* Interactive React Catalog Explorer */}
    <CatalogExplorer client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />

    {/* Floating Advisor Chat */}
    <AdvisorChatWidget client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />
  </div>
</Layout>