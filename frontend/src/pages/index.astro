---
import Layout from "@/layouts/Layout.astro";
import { CatalogExplorer } from "@/components/CatalogExplorer";
import { AdvisorChatWidget } from "@/components/AdvisorChatWidget";

// Backend API configuration from env or relative path default
const apiBaseUrl = import.meta.env.PUBLIC_API_URL !== undefined ? import.meta.env.PUBLIC_API_URL : "";
const apiKey = import.meta.env.PUBLIC_API_KEY || "dB57RDrRgEPNO6VK9AGUZoNwWANPBlrGgTOqk1D28OUqy5OhetekKsqfKDDAdoHoB7BowKMniCR4Guoiqxd2uNJyiKPyXKMS4AtgmC87FbzyJmPGeG7wJDFiRfwZp6Gj";
---

<Layout title="Ópticas Chile - Comparador de Precios y Catálogo en Vivo">
  <div class="space-y-6">
    {/* Hero Section */}
    <div class="text-center max-w-3xl mx-auto space-y-3 pt-2 pb-1">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
        Compara y Ahorra en <span class="bg-gradient-to-r from-emerald-400 via-primary to-indigo-400 bg-clip-text text-transparent">Ópticas de Chile</span>
      </h2>
      <p class="text-sm text-muted-foreground leading-relaxed max-w-2xl mx-auto font-normal">
        Monitoreo diario de ofertas y precios en GMO, Rotter & Krauss, Schilling, Place Vendôme, Econópticas, Karün y Lentesplus.
      </p>
    </div>

    {/* Interactive React Catalog Explorer */}
    <CatalogExplorer client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />

    {/* Floating Advisor Chat */}
    <AdvisorChatWidget client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />
  </div>
</Layout>