---
import Layout from "@/layouts/Layout.astro";
import { CatalogExplorer } from "@/components/CatalogExplorer";
import { AdvisorChatWidget } from "@/components/AdvisorChatWidget";

// Backend API configuration from env or fallback
const apiBaseUrl = import.meta.env.PUBLIC_API_URL || "http://192.168.1.85:8008";
const apiKey = import.meta.env.PUBLIC_API_KEY || "dB57RDrRgEPNO6VK9AGUZoNwWANPBlrGgTOqk1D28OUqy5OhetekKsqfKDDAdoHoB7BowKMniCR4Guoiqxd2uNJyiKPyXKMS4AtgmC87FbzyJmPGeG7wJDFiRfwZp6Gj";
---

<Layout title="👓 Ópticas Chile - Comparador de Precios & Catálogo">
  <div class="space-y-8">
    {/* Hero Section */}
    <div class="text-center max-w-3xl mx-auto space-y-3 pt-4 pb-2">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-bold">
        <span>⚡ 7 Cadenas Monitoreadas en Tiempo Real</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Encuentra el Mejor Precio en <span class="bg-gradient-to-r from-primary to-indigo-500 bg-clip-text text-transparent">Lentes y Ópticas de Chile</span>
      </h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Monitoreo continuo de precios, detección de ofertas reales y búsqueda semántica con IA sobre GMO, Rotter & Krauss, Schilling, Place Vendôme, Econópticas, Karün y Lentesplus.
      </p>
    </div>

    {/* Interactive React Catalog Explorer */}
    <CatalogExplorer client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />

    {/* Floating AI Advisor Chat (Ollama Qwen2.5) */}
    <AdvisorChatWidget client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />
  </div>
</Layout>