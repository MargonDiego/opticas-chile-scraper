---
import Layout from "@/layouts/Layout.astro";
import { CatalogExplorer } from "@/components/CatalogExplorer";
import { AdvisorChatWidget } from "@/components/AdvisorChatWidget";

// Backend API configuration from env or production default
const apiBaseUrl = import.meta.env.PUBLIC_API_URL || "https://api-lentes.ste-tellega.com";
const apiKey = import.meta.env.PUBLIC_API_KEY || "";

// The seven chains the index is built from. The names are stated plainly:
// the footer carries the disclaimer, this list carries the sources.
const chains = [
  "GMO",
  "Rotter & Krauss",
  "Ópticas Schilling",
  "Place Vendôme",
  "Econópticas",
  "Karün",
  "Lentesplus",
];
---

<Layout title="Ópticas Chile — Comparador de precios de lentes">
  <!-- The hero is the search field itself: a heading, one sentence, then the tool. -->
  <section id="buscar" class="pb-6 sm:pb-8">
    <h1
      class="text-display text-balance text-foreground sm:text-[38px] lg:text-[44px] max-w-2xl"
    >
      Los precios reales de los lentes en las ópticas de Chile
    </h1>
    <p class="mt-3 text-body text-muted-foreground max-w-prose sm:text-[16px]">
      Comparamos el catálogo público de siete ópticas y te mostramos el precio de
      cada armazón, el descuento de hoy y su historial. No estamos afiliados a las
      tiendas: solo el precio.
    </p>
  </section>

  <!-- Interactive React Catalog Explorer -->
  <CatalogExplorer client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />

  <section id="como-funciona" class="mt-16 pt-8 border-t border-border sm:mt-24">
    <h2 class="text-headline text-foreground">Cómo funciona</h2>
    <p class="mt-3 text-body text-muted-foreground max-w-prose">
      Recorremos el catálogo público de cada óptica y guardamos el precio de cada
      armazón y lente. Cuando el mismo modelo aparece más barato en otra tienda, te
      mostramos el monto exacto, no un porcentaje.
    </p>
    <p class="mt-3 text-body text-muted-foreground max-w-prose">
      Cada precio queda registrado. Si una tienda sube o baja el precio de un modelo,
      el historial muestra cuándo pasó y cuánto cambió. No vendemos nada y no
      estamos afiliados a ninguna cadena.
    </p>
  </section>

  <section id="fuentes" class="mt-12 pt-8 border-t border-border sm:mt-16">
    <h2 class="text-headline text-foreground">Fuentes</h2>
    <p class="mt-3 text-body text-muted-foreground max-w-prose">
      El catálogo se construye a partir del sitio público de cada tienda, revisado
      de forma automática.
    </p>
    <ul
      class="mt-4 grid grid-cols-1 gap-x-10 sm:grid-cols-2"
    >
      {
        chains.map((chain) => (
          <li class="border-b border-border py-3 text-body text-foreground last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
            {chain}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Floating Advisor Chat -->
  <AdvisorChatWidget client:load apiBaseUrl={apiBaseUrl} apiKey={apiKey} />
</Layout>
