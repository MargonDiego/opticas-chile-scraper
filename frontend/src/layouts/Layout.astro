---
import Navbar from "@/components/Navbar.astro";
import "@/styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Ópticas Chile - Comparador de Precios y Catálogo" } = Astro.props;

const description =
  "Precios reales de armazones y lentes en las ópticas de Chile, actualizados automáticamente. Sin afiliación con las tiendas: solo el precio, el descuento y su historial.";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es-CL" class="">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#f2f6f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Self-hosted Plus Jakarta Sans. No third-party stylesheet in the
      critical path; the three weights used above the fold are preloaded.
    -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Ópticas Chile — Comparador de precios de lentes"
    />
    <meta
      property="og:description"
      content="Precios reales de armazones y lentes en las ópticas de Chile, actualizados automáticamente. Sin afiliación con las tiendas."
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-primary-foreground"
    >
      Ir al catálogo
    </a>

    <Navbar />

    <main id="contenido" tabindex="-1" class="container flex-1 py-8 sm:py-10">
      <slot />
    </main>

    <footer class="border-t border-border bg-background safe-bottom">
      <div class="container pt-8 pb-6">
        <div
          class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-10"
        >
          <div class="max-w-prose">
            <a
              href="/"
              aria-label="Ópticas Chile, ir al inicio"
              class="inline-flex min-h-11 items-center gap-2 rounded-sm text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-foreground text-background"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="6" cy="15" r="4"></circle>
                  <circle cx="18" cy="15" r="4"></circle>
                  <line x1="14" y1="15" x2="10" y2="15"></line>
                  <path d="M2.5 13 5 7c.7-1.3 1.4-2 3-2"></path>
                  <path d="M21.5 13 19 7c-.7-1.3-1.4-2-3-2"></path>
                </svg>
              </span>
              <span
                class="text-[15px] font-semibold tracking-normal text-foreground"
                >Ópticas Chile</span
              >
            </a>

            <p class="mt-4 text-body-sm text-muted-foreground">
              Comparador independiente de precios de armazones y lentes en Chile.
            </p>
            <p class="mt-2 text-body-sm text-muted-foreground">
              No estamos afiliados a las cadenas de ópticas. Los precios provienen
              de los catálogos públicos de cada tienda y pueden cambiar sin aviso.
            </p>
          </div>

          <p class="shrink-0 text-body-sm text-muted-foreground sm:pt-1">
            © {year} Ópticas Chile
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
