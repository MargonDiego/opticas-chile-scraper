---
import Navbar from "@/components/Navbar.astro";
import "@/styles/globals.css";

interface Props {
  title?: string;
}

const { title = "👓 Ópticas Chile - Comparador de Precios & Asesor IA" } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="Comparador de precios, historial de fluctuaciones y asesor IA para ópticas en Chile." />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased flex flex-col">
    <Navbar />
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-8">
      <slot />
    </main>
    <footer class="border-t border-border/60 py-6 text-center text-xs text-muted-foreground bg-muted/20">
      <p>👓 Ópticas Chile Price Monitor • Desarrollado con Astro, shadcn/ui, pgvector y Ollama en Homelab.</p>
    </footer>
  </body>
</html>