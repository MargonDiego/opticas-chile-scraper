# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cybersecurity & Authentication (Set API_KEY to protect endpoints)
API_KEY=
CORS_ORIGINS=*
ENABLE_SECURITY_HEADERS=true

# Database Configuration (SQLite default for local dev/test; overridden in Docker Compose for PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///data/opticas.db

# Postgres Credentials (used when running via Docker Compose)
POSTGRES_USER=opticas_user
POSTGRES_PASSWORD=opticas_pass_123
POSTGRES_DB=opticas_db

# Ollama AI & Embeddings (Homelab 192.168.1.85)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:1.5b
EMBEDDING_DIMENSION=768

# Scraper Settings
DEFAULT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_CONCURRENCY=5
SCRAPER_RETRY_ATTEMPTS=3
AUTO_SCRAPE_INTERVAL_HOURS=12

# Spider Engine
SPIDER_API_KEY=
SPIDER_HOST=http://localhost:3030